(* Forge v1 parser-oriented grammar. Semantic restrictions are in the language spec. *)

file            = module_decl, { import_decl }, { declaration } ;
module_decl     = "module", qualified_name, ";" ;
import_decl     = "import", qualified_name, { ",", qualified_name }, ";" ;

declaration     = metadata*, [ "pub" ], ( value_decl | function_decl | struct_decl | enum_decl
                | tagged_decl | bitstruct_decl | distinct_decl | type_decl | impl_decl | extern_decl ) ;

metadata        = "@", identifier, [ "(", fdn_argument_list, ")" ]
                | "@", fdn_map ;
postfix_metadata = "@", identifier, [ "(", fdn_argument_list, ")" ] ;

value_decl      = ("val" | "var" | "const"), pattern, [ ":", type ], "=", expression ;

function_decl   = ("fn" | "nfn"), identifier, "(", [ parameter_list ], ")",
                  [ "->", type ], block ;
parameter_list  = parameter, { ",", parameter } ;
parameter       = identifier, ":", type, [ "=", expression ] ;

struct_decl     = "struct", identifier, "{", { field_decl }, "}" ;
field_decl      = metadata*, identifier, ":", type, [ "=", expression ], ";" ;

enum_decl       = "enum", identifier, "{", enum_item, { ",", enum_item }, [","], "}" ;
enum_item       = identifier, [ "=", constant_expression ] ;

tagged_decl     = "tagged", identifier, "{", variant, { ",", variant }, [","], "}" ;
variant         = identifier, [ "{", { field_decl }, "}" ] ;

bitstruct_decl  = "bitstruct", identifier, ":", integer_type, "{", { bit_field }, "}" ;
bit_field       = identifier, ":", integer, ";" ;

distinct_decl   = "distinct", identifier, ":", type, ";" ;
type_decl       = "type", identifier, "=", type, { postfix_metadata }, ";" ;

impl_decl       = "impl", qualified_name, "{", { metadata*, function_decl }, "}" ;
extern_decl     = "extern", string_literal, "{", { extern_function_decl }, "}" ;
extern_function_decl = "fn", identifier, "(", [ parameter_list ], ")", [ "->", type ], ";" ;

type            = primary_type, { type_suffix } ;
type_suffix     = "?" | "[", "]", [ "mut" ] | postfix_metadata ;
primary_type    = qualified_name
                | "*", [ "volatile" ], type
                | "&", [ "mut" ], type
                | "[", type, ";", constant_expression, "]"
                | "fn", "(", [ type_list ], ")", "->", type
                | "closure", "(", [ type_list ], ")", "->", type
                | "Result", "[", type, ",", type, "]" ;

statement       = value_decl, ";"
                | assignment_stmt
                | expression, ";"
                | block
                | if_stmt
                | while_stmt
                | for_stmt
                | match_stmt
                | defer_stmt
                | return_stmt
                | break_stmt
                | continue_stmt
                | unsafe_stmt
                | with_context_stmt
                | select_stmt ;

assignment_stmt = assignable, "=", expression, ";" ;
assignable      = identifier | postfix_expression ;

block           = "{", { statement }, "}" ;
if_stmt         = "if", "(", expression, ")", block, [ "else", (block | if_stmt) ] ;
while_stmt      = "while", "(", expression, ")", block ;
for_stmt        = "for", "(", ( c_for_header | iteration_header ), ")", block ;
c_for_header    = [ for_init ], ";", [ expression ], ";", [ for_step ] ;
for_init        = value_decl | assignment_no_semi | expression ;
for_step        = assignment_no_semi | expression ;
assignment_no_semi = assignable, "=", expression ;
iteration_header = ("val" | "var"), pattern, "in", expression ;

match_stmt      = "match", "(", expression, ")", "{", { match_arm }, "}" ;
match_arm       = pattern, [ "when", expression ], "=>", ( block | expression ), ["," | ";"] ;

defer_stmt      = "defer", ( block | expression, ";" ) ;
return_stmt     = "return", [ "tail" ], [ expression ], ";" ;
break_stmt      = "break", ";" ;
continue_stmt   = "continue", ";" ;
unsafe_stmt     = "unsafe", block ;
with_context_stmt = "with", "context", fdn_map, block ;

pattern         = or_pattern ;
or_pattern      = as_pattern, { "|", as_pattern } ;
as_pattern      = [ identifier, "@" ], base_pattern ;
base_pattern    = "_"
                | literal
                | range_pattern
                | identifier
                | qualified_variant, [ "{", [ pattern_fields ], "}" ]
                | "None", [ "{", "}" ]
                | "Some", "(", pattern, ")"
                | struct_pattern
                | sequence_pattern
                | map_pattern ;
qualified_variant = qualified_name, "::", identifier ;
struct_pattern  = qualified_name, "{", [ pattern_fields ], "}" ;
pattern_fields  = pattern_field, { ",", pattern_field }, [","] ;
pattern_field   = identifier, [ ":", pattern ] ;
sequence_pattern = "[", [ sequence_items ], "]" ;
sequence_items  = pattern, { ",", pattern }, [ ",", "..", [ identifier ] ]
                | "..", [ identifier ] ;
map_pattern     = "{", [ map_pattern_items ], "}" ;
map_pattern_items = map_pattern_item, { ",", map_pattern_item }, [ ",", ".." ]
                  | ".." ;
map_pattern_item = keyword, identifier, [ "?" ] ;
range_pattern   = literal, (".." | "..="), literal ;

expression      = logical_or_expression, { postfix_metadata } ;
postfix_expression = primary_expression, { call_suffix | index_suffix | member_suffix } ;
member_suffix   = ".", identifier ;
call_suffix     = "(", [ call_arguments ], ")" ;
call_arguments  = positional_arguments | named_arguments ;
positional_arguments = expression, { ",", expression }, [","] ;
named_arguments = named_argument, { ",", named_argument }, [","] ;
named_argument  = keyword, "=", expression ;
index_suffix    = "[", expression, "]" ;

closure_expression = [ capture_list ], "(", [ parameter_list ], ")", [ "->", type ], block ;
capture_list    = "[", capture, { ",", capture }, [","], "]" ;
capture         = identifier | "&", [ "mut" ], identifier ;
(* An empty capture list [] is not legal; omit the list when there are no captures. *)

reader_form     = "#", qualified_name, fdn_value ;

select_stmt     = "select", "{", { select_arm }, "}" ;
select_arm      = "recv", expression, "->", pattern, "=>", block
                | "timeout", expression, "=>", block ;

(* FDN *)
fdn_value       = fdn_scalar | fdn_vector | fdn_list | fdn_map | fdn_set | fdn_tagged ;
fdn_vector      = "[", { fdn_value, [","] }, "]" ;
fdn_list        = "(", { fdn_value, [","] }, ")" ;
fdn_map         = "{", { fdn_value, fdn_value, [","] }, "}" ;
fdn_set         = "#{", { fdn_value, [","] }, "}" ;
fdn_tagged      = "#", qualified_name, fdn_value ;
fdn_argument_list = [ fdn_value, { ",", fdn_value } ] ;

(* Reserved/rejected in v1: `internal`, `switch`, compound assignment operators,
   empty closure capture list `[]`, pattern conjunction `&`, pattern negation `!`. *)
