module forge_collections;

import std.collections.raw_usize;
import std.collections.raw_string;
import std.string;

// Bootstrap collection implementation note:
//
// The collection algorithms and logical metadata live in Forge source. CForge
// currently supplies only raw typed indexed storage primitives because the
// interpreter cannot yet execute allocator-backed raw pointer mutation.
// Replacing raw_* with Allocator-backed Forge storage must not change these
// public collection semantics.

// ---------------------------------------------------------------------------
// ListUsize
// Layout in raw_usize storage:
//   [0] logical length
//   [1] logical capacity
//   [2..] elements
// ---------------------------------------------------------------------------

pub fn list_usize_create(capacity: usize) -> usize {
    val handle: usize = raw_usize.create(capacity + 2);
    raw_usize.set(handle, 0, 0);
    raw_usize.set(handle, 1, capacity);
    return handle;
}

pub fn list_usize_len(list: usize) -> usize {
    return raw_usize.get(list, 0);
}

pub fn list_usize_capacity(list: usize) -> usize {
    return raw_usize.get(list, 1);
}

pub fn list_usize_is_empty(list: usize) -> bool {
    return list_usize_len(list) == 0;
}

fn list_usize_grow_to(list: usize, requested: usize) -> void {
    val current: usize = list_usize_capacity(list);
    if (requested <= current) { return; }

    var next: usize = current;
    if (next == 0) { next = 4; }
    while (next < requested) {
        next = next * 2;
    }

    raw_usize.resize(list, next + 2);
    raw_usize.set(list, 1, next);
}

pub fn list_usize_reserve(list: usize, capacity: usize) -> void {
    list_usize_grow_to(list, capacity);
}

pub fn list_usize_push(list: usize, value: usize) -> void {
    val len: usize = list_usize_len(list);
    if (len == list_usize_capacity(list)) {
        list_usize_grow_to(list, len + 1);
    }
    raw_usize.set(list, len + 2, value);
    raw_usize.set(list, 0, len + 1);
}

pub fn list_usize_get(list: usize, index: usize) -> usize {
    return raw_usize.get(list, index + 2);
}

pub fn list_usize_set(list: usize, index: usize, value: usize) -> void {
    raw_usize.set(list, index + 2, value);
}

pub fn list_usize_pop_or(list: usize, fallback: usize) -> usize {
    val len: usize = list_usize_len(list);
    if (len == 0) { return fallback; }
    val new_len: usize = len - 1;
    val value: usize = raw_usize.get(list, new_len + 2);
    raw_usize.set(list, 0, new_len);
    return value;
}

pub fn list_usize_remove(list: usize, index: usize) -> usize {
    val len: usize = list_usize_len(list);
    val removed: usize = raw_usize.get(list, index + 2);
    var i: usize = index;
    while ((i + 1) < len) {
        raw_usize.set(list, i + 2, raw_usize.get(list, i + 3));
        i = i + 1;
    }
    raw_usize.set(list, 0, len - 1);
    return removed;
}

pub fn list_usize_clear(list: usize) -> void {
    raw_usize.set(list, 0, 0);
}

// ---------------------------------------------------------------------------
// ListString
// Layout in raw_string storage:
//   [0] logical length encoded as decimal usize
//   [1] logical capacity encoded as decimal usize
//   [2..] elements
// The decimal metadata is a temporary interpreter-storage accommodation, not
// the final native layout.
// ---------------------------------------------------------------------------

pub fn list_string_create(capacity: usize) -> usize {
    val handle: usize = raw_string.create(capacity + 2);
    raw_string.set(handle, 0, "0");
    raw_string.set(handle, 1, string.from_usize(capacity));
    return handle;
}

pub fn list_string_len(list: usize) -> usize {
    return string.parse_usize(raw_string.get(list, 0));
}

pub fn list_string_capacity(list: usize) -> usize {
    return string.parse_usize(raw_string.get(list, 1));
}

pub fn list_string_is_empty(list: usize) -> bool {
    return list_string_len(list) == 0;
}

fn list_string_grow_to(list: usize, requested: usize) -> void {
    val current: usize = list_string_capacity(list);
    if (requested <= current) { return; }

    var next: usize = current;
    if (next == 0) { next = 4; }
    while (next < requested) {
        next = next * 2;
    }

    raw_string.resize(list, next + 2);
    raw_string.set(list, 1, string.from_usize(next));
}

pub fn list_string_reserve(list: usize, capacity: usize) -> void {
    list_string_grow_to(list, capacity);
}

pub fn list_string_push(list: usize, value: str) -> void {
    val len: usize = list_string_len(list);
    if (len == list_string_capacity(list)) {
        list_string_grow_to(list, len + 1);
    }
    raw_string.set(list, len + 2, value);
    raw_string.set(list, 0, string.from_usize(len + 1));
}

pub fn list_string_get(list: usize, index: usize) -> str {
    return raw_string.get(list, index + 2);
}

pub fn list_string_set(list: usize, index: usize, value: str) -> void {
    raw_string.set(list, index + 2, value);
}

pub fn list_string_pop_or(list: usize, fallback: str) -> str {
    val len: usize = list_string_len(list);
    if (len == 0) { return fallback; }
    val new_len: usize = len - 1;
    val value: str = raw_string.get(list, new_len + 2);
    raw_string.set(list, 0, string.from_usize(new_len));
    return value;
}

pub fn list_string_remove(list: usize, index: usize) -> str {
    val len: usize = list_string_len(list);
    val removed: str = raw_string.get(list, index + 2);
    var i: usize = index;
    while ((i + 1) < len) {
        raw_string.set(list, i + 2, raw_string.get(list, i + 3));
        i = i + 1;
    }
    raw_string.set(list, 0, string.from_usize(len - 1));
    return removed;
}

pub fn list_string_clear(list: usize) -> void {
    raw_string.set(list, 0, "0");
}

// ---------------------------------------------------------------------------
// HashMapStringString
// Open addressing with linear probing.
//
// raw_string layout:
//   [0] live entry count (decimal)
//   [1] bucket count (decimal)
//   bucket N occupies 3 slots:
//     state: "" empty, "1" occupied, "2" tombstone
//     key
//     value
//
// The table grows at >= 70% occupancy. Iteration order is deliberately not an
// API guarantee.
// ---------------------------------------------------------------------------

fn hash_string(value: str, buckets: usize) -> usize {
    var hash: usize = 0;
    var i: usize = 0;
    val bytes: usize = string.byte_len(value);
    while (i < bytes) {
        hash = ((hash * 131) + string.byte_at(value, i)) % 4294967291;
        i = i + 1;
    }
    return hash % buckets;
}

fn map_len(map: usize) -> usize {
    return string.parse_usize(raw_string.get(map, 0));
}

fn map_buckets(map: usize) -> usize {
    return string.parse_usize(raw_string.get(map, 1));
}

fn bucket_state_slot(index: usize) -> usize {
    return 2 + (index * 3);
}

fn bucket_key_slot(index: usize) -> usize {
    return 3 + (index * 3);
}

fn bucket_value_slot(index: usize) -> usize {
    return 4 + (index * 3);
}

fn map_create_exact(buckets: usize) -> usize {
    val map: usize = raw_string.create(2 + (buckets * 3));
    raw_string.set(map, 0, "0");
    raw_string.set(map, 1, string.from_usize(buckets));
    return map;
}

pub fn hash_map_string_string_create() -> usize {
    return map_create_exact(8);
}

pub fn hash_map_string_string_len(map: usize) -> usize {
    return map_len(map);
}

pub fn hash_map_string_string_is_empty(map: usize) -> bool {
    return map_len(map) == 0;
}

fn map_put_no_grow(map: usize, key: str, value: str) -> bool {
    val buckets: usize = map_buckets(map);
    val start: usize = hash_string(key, buckets);
    var probe: usize = 0;
    var first_deleted: usize = buckets;
    var inserted: bool = false;
    var done: bool = false;

    while ((probe < buckets) && !done) {
        val index: usize = (start + probe) % buckets;
        val state_slot: usize = bucket_state_slot(index);
        val state: str = raw_string.get(map, state_slot);

        if (state == "1") {
            if (raw_string.get(map, bucket_key_slot(index)) == key) {
                raw_string.set(map, bucket_value_slot(index), value);
                done = true;
            }
        } else {
            if (state == "2") {
                if (first_deleted == buckets) {
                    first_deleted = index;
                }
            } else {
                var target: usize = index;
                if (first_deleted < buckets) { target = first_deleted; }
                raw_string.set(map, bucket_state_slot(target), "1");
                raw_string.set(map, bucket_key_slot(target), key);
                raw_string.set(map, bucket_value_slot(target), value);
                raw_string.set(map, 0, string.from_usize(map_len(map) + 1));
                inserted = true;
                done = true;
            }
        }
        probe = probe + 1;
    }

    if (!done && (first_deleted < buckets)) {
        raw_string.set(map, bucket_state_slot(first_deleted), "1");
        raw_string.set(map, bucket_key_slot(first_deleted), key);
        raw_string.set(map, bucket_value_slot(first_deleted), value);
        raw_string.set(map, 0, string.from_usize(map_len(map) + 1));
        inserted = true;
    }

    return inserted;
}

fn map_rehash(map: usize, new_buckets: usize) -> void {
    val old_buckets: usize = map_buckets(map);
    val replacement: usize = map_create_exact(new_buckets);
    var i: usize = 0;

    while (i < old_buckets) {
        if (raw_string.get(map, bucket_state_slot(i)) == "1") {
            val key: str = raw_string.get(map, bucket_key_slot(i));
            val value: str = raw_string.get(map, bucket_value_slot(i));
            map_put_no_grow(replacement, key, value);
        }
        i = i + 1;
    }

    raw_string.swap(map, replacement);
}

pub fn hash_map_string_string_put(map: usize, key: str, value: str) -> bool {
    val len: usize = map_len(map);
    val buckets: usize = map_buckets(map);
    if (((len + 1) * 10) >= (buckets * 7)) {
        map_rehash(map, buckets * 2);
    }
    return map_put_no_grow(map, key, value);
}

pub fn hash_map_string_string_contains(map: usize, key: str) -> bool {
    val buckets: usize = map_buckets(map);
    val start: usize = hash_string(key, buckets);
    var probe: usize = 0;
    var found: bool = false;
    var done: bool = false;

    while ((probe < buckets) && !done) {
        val index: usize = (start + probe) % buckets;
        val state: str = raw_string.get(map, bucket_state_slot(index));
        if (state == "") {
            done = true;
        } else {
            if (state == "1") {
                if (raw_string.get(map, bucket_key_slot(index)) == key) {
                    found = true;
                    done = true;
                }
            }
        }
        probe = probe + 1;
    }
    return found;
}

pub fn hash_map_string_string_get_or(map: usize, key: str, fallback: str) -> str {
    val buckets: usize = map_buckets(map);
    val start: usize = hash_string(key, buckets);
    var probe: usize = 0;
    var value: str = fallback;
    var done: bool = false;

    while ((probe < buckets) && !done) {
        val index: usize = (start + probe) % buckets;
        val state: str = raw_string.get(map, bucket_state_slot(index));
        if (state == "") {
            done = true;
        } else {
            if (state == "1") {
                if (raw_string.get(map, bucket_key_slot(index)) == key) {
                    value = raw_string.get(map, bucket_value_slot(index));
                    done = true;
                }
            }
        }
        probe = probe + 1;
    }
    return value;
}

pub fn hash_map_string_string_remove(map: usize, key: str) -> bool {
    val buckets: usize = map_buckets(map);
    val start: usize = hash_string(key, buckets);
    var probe: usize = 0;
    var removed: bool = false;
    var done: bool = false;

    while ((probe < buckets) && !done) {
        val index: usize = (start + probe) % buckets;
        val state: str = raw_string.get(map, bucket_state_slot(index));
        if (state == "") {
            done = true;
        } else {
            if (state == "1") {
                if (raw_string.get(map, bucket_key_slot(index)) == key) {
                    raw_string.set(map, bucket_state_slot(index), "2");
                    raw_string.set(map, bucket_key_slot(index), "");
                    raw_string.set(map, bucket_value_slot(index), "");
                    raw_string.set(map, 0, string.from_usize(map_len(map) - 1));
                    removed = true;
                    done = true;
                }
            }
        }
        probe = probe + 1;
    }
    return removed;
}

pub fn hash_map_string_string_clear(map: usize) -> void {
    val buckets: usize = map_buckets(map);
    var i: usize = 0;
    while (i < buckets) {
        raw_string.set(map, bucket_state_slot(i), "");
        raw_string.set(map, bucket_key_slot(i), "");
        raw_string.set(map, bucket_value_slot(i), "");
        i = i + 1;
    }
    raw_string.set(map, 0, "0");
}

// ---------------------------------------------------------------------------
// HashSetString: same table engine, dummy map value.
// ---------------------------------------------------------------------------

pub fn hash_set_string_create() -> usize {
    return hash_map_string_string_create();
}

pub fn hash_set_string_len(set: usize) -> usize {
    return hash_map_string_string_len(set);
}

pub fn hash_set_string_contains(set: usize, value: str) -> bool {
    return hash_map_string_string_contains(set, value);
}

pub fn hash_set_string_insert(set: usize, value: str) -> bool {
    return hash_map_string_string_put(set, value, "1");
}

pub fn hash_set_string_remove(set: usize, value: str) -> bool {
    return hash_map_string_string_remove(set, value);
}

pub fn hash_set_string_clear(set: usize) -> void {
    hash_map_string_string_clear(set);
}
