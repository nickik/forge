module core.io;

import core;

// Non-allocating byte output capability suitable for serial consoles, fixed
// buffers, hosted stderr adapters, early boot logs, and panic paths.

pub enum WriteError {
    Full,
    Device,
    Invalid,
}

pub struct WriterOps {
    write: fn(*void, byte[], usize) -> Result[usize, WriteError];
}

pub struct Writer {
    context: *void;
    ops: &WriterOps;
}

pub fn writer_write(writer: &mut Writer, bytes: byte[], len: usize) -> Result[usize, WriteError] {
    return writer.ops.write(writer.context, bytes, len);
}

