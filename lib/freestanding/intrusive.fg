module core.intrusive;

import core;

// Allocation-free linkage for kernel queues/lists. The container never owns
// nodes and therefore never allocates merely to enqueue an existing object.

pub struct IntrusiveLink {
    prev: *IntrusiveLink?;
    next: *IntrusiveLink?;
}

pub struct IntrusiveList {
    head: *IntrusiveLink?;
    tail: *IntrusiveLink?;
    len: usize;
}

pub fn intrusive_list_len(list: &IntrusiveList) -> usize {
    return list.len;
}

pub fn intrusive_list_is_empty(list: &IntrusiveList) -> bool {
    return list.len == 0;
}

