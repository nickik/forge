module std.args;

import core;

// Hosted process argument access. The runtime/provider supplies the actual
// argument vector; applications see a target-independent API.
nfn __forge_args_count() -> usize {
}

nfn __forge_args_get(index: usize) -> str {
}

pub fn count() -> usize {
    return __forge_args_count();
}

pub fn get(index: usize) -> str {
    return __forge_args_get(index);
}
