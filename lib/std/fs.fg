module std.fs;

import core;

// Minimal hosted filesystem API needed by early integration programs. The
// provider is target-selected (Unix, CForge host, Cosmic userspace, ...).
nfn __forge_fs_read_text(path: str) -> str {
}

nfn __forge_fs_write_text(path: str, text: str) -> void {
}

nfn __forge_fs_append_text(path: str, text: str) -> void {
}

pub fn read_text(path: str) -> str {
    return __forge_fs_read_text(path);
}

pub fn write_text(path: str, text: str) -> void {
    __forge_fs_write_text(path, text);
}

pub fn append_text(path: str, text: str) -> void {
    __forge_fs_append_text(path, text);
}
