module examples.collections_smoke;

import forge_collections;

fn main() -> i32 {
    val numbers: usize = forge_collections.list_usize_create(0);
    forge_collections.list_usize_push(numbers, 10);
    forge_collections.list_usize_push(numbers, 20);
    forge_collections.list_usize_push(numbers, 30);
    forge_collections.list_usize_push(numbers, 40);
    forge_collections.list_usize_push(numbers, 50);

    if (forge_collections.list_usize_len(numbers) != 5) { return 1; }
    if (forge_collections.list_usize_capacity(numbers) < 5) { return 2; }
    if (forge_collections.list_usize_get(numbers, 2) != 30) { return 3; }
    forge_collections.list_usize_set(numbers, 2, 31);
    if (forge_collections.list_usize_get(numbers, 2) != 31) { return 4; }
    forge_collections.list_usize_set(numbers, 2, 30);
    if (forge_collections.list_usize_remove(numbers, 1) != 20) { return 5; }
    if (forge_collections.list_usize_get(numbers, 1) != 30) { return 6; }
    if (forge_collections.list_usize_pop_or(numbers, 999) != 50) { return 7; }
    forge_collections.list_usize_reserve(numbers, 32);
    if (forge_collections.list_usize_capacity(numbers) < 32) { return 8; }
    forge_collections.list_usize_clear(numbers);
    if (!forge_collections.list_usize_is_empty(numbers)) { return 9; }
    if (forge_collections.list_usize_pop_or(numbers, 999) != 999) { return 10; }

    val words: usize = forge_collections.list_string_create(1);
    forge_collections.list_string_push(words, "alpha");
    forge_collections.list_string_push(words, "beta");
    forge_collections.list_string_push(words, "gamma");
    if (forge_collections.list_string_len(words) != 3) { return 11; }
    if (forge_collections.list_string_get(words, 1) != "beta") { return 12; }
    forge_collections.list_string_set(words, 1, "BETA");
    if (forge_collections.list_string_get(words, 1) != "BETA") { return 13; }
    forge_collections.list_string_set(words, 1, "beta");
    if (forge_collections.list_string_remove(words, 0) != "alpha") { return 14; }
    if (forge_collections.list_string_get(words, 0) != "beta") { return 15; }

    val map: usize = forge_collections.hash_map_string_string_create();
    if (!forge_collections.hash_map_string_string_put(map, "a", "1")) { return 16; }
    if (!forge_collections.hash_map_string_string_put(map, "b", "2")) { return 17; }
    if (forge_collections.hash_map_string_string_put(map, "a", "3")) { return 18; }
    if (forge_collections.hash_map_string_string_len(map) != 2) { return 19; }
    if (forge_collections.hash_map_string_string_get_or(map, "a", "missing") != "3") { return 20; }
    if (forge_collections.hash_map_string_string_get_or(map, "x", "missing") != "missing") { return 21; }

    // Force table growth and rehash.
    forge_collections.hash_map_string_string_put(map, "c", "3");
    forge_collections.hash_map_string_string_put(map, "d", "4");
    forge_collections.hash_map_string_string_put(map, "e", "5");
    forge_collections.hash_map_string_string_put(map, "f", "6");
    forge_collections.hash_map_string_string_put(map, "g", "7");
    forge_collections.hash_map_string_string_put(map, "h", "8");
    forge_collections.hash_map_string_string_put(map, "i", "9");
    if (forge_collections.hash_map_string_string_len(map) != 9) { return 22; }
    if (forge_collections.hash_map_string_string_get_or(map, "h", "missing") != "8") { return 23; }

    // Deletion must leave probe chains usable, and insertion must reuse the table.
    if (!forge_collections.hash_map_string_string_remove(map, "d")) { return 24; }
    if (forge_collections.hash_map_string_string_contains(map, "d")) { return 25; }
    if (forge_collections.hash_map_string_string_get_or(map, "h", "missing") != "8") { return 26; }
    if (!forge_collections.hash_map_string_string_put(map, "j", "10")) { return 27; }

    // Deterministic collision in the initial 8-bucket table: ASCII 'a' (97)
    // and 'i' (105) both hash to bucket 1. Deleting the first entry must not
    // terminate lookup of the second entry behind its tombstone.
    val collision_map: usize = forge_collections.hash_map_string_string_create();
    if (!forge_collections.hash_map_string_string_put(collision_map, "a", "left")) { return 28; }
    if (!forge_collections.hash_map_string_string_put(collision_map, "i", "right")) { return 29; }
    if (forge_collections.hash_map_string_string_get_or(collision_map, "i", "missing") != "right") { return 30; }
    if (!forge_collections.hash_map_string_string_remove(collision_map, "a")) { return 31; }
    if (forge_collections.hash_map_string_string_get_or(collision_map, "i", "missing") != "right") { return 32; }
    if (!forge_collections.hash_map_string_string_put(collision_map, "q", "reuse")) { return 33; }
    if (forge_collections.hash_map_string_string_get_or(collision_map, "q", "missing") != "reuse") { return 34; }
    forge_collections.hash_map_string_string_clear(collision_map);
    if (!forge_collections.hash_map_string_string_is_empty(collision_map)) { return 35; }

    val set: usize = forge_collections.hash_set_string_create();
    if (!forge_collections.hash_set_string_insert(set, "red")) { return 36; }
    if (forge_collections.hash_set_string_insert(set, "red")) { return 37; }
    if (!forge_collections.hash_set_string_insert(set, "blue")) { return 38; }
    if (!forge_collections.hash_set_string_contains(set, "blue")) { return 39; }
    if (forge_collections.hash_set_string_len(set) != 2) { return 40; }
    if (!forge_collections.hash_set_string_remove(set, "red")) { return 41; }
    if (forge_collections.hash_set_string_contains(set, "red")) { return 42; }
    forge_collections.hash_set_string_clear(set);
    if (forge_collections.hash_set_string_len(set) != 0) { return 43; }

    return 0;
}
