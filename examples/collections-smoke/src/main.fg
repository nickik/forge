module examples.collections_smoke;

import forge_collections;

fn main() -> i32 {
    val numbers: usize = forge_collections.list_usize_create(0);
    forge_collections.list_usize_push(numbers, 10);
    forge_collections.list_usize_push(numbers, 20);
    forge_collections.list_usize_push(numbers, 30);
    forge_collections.list_usize_push(numbers, 40);
    forge_collections.list_usize_push(numbers, 50);

    if (forge_collections.list_usize_len(numbers) != 5) { return 1; }
    if (forge_collections.list_usize_capacity(numbers) < 5) { return 2; }
    if (forge_collections.list_usize_get(numbers, 2) != 30) { return 3; }
    if (forge_collections.list_usize_remove(numbers, 1) != 20) { return 4; }
    if (forge_collections.list_usize_get(numbers, 1) != 30) { return 5; }
    if (forge_collections.list_usize_pop_or(numbers, 999) != 50) { return 6; }

    val words: usize = forge_collections.list_string_create(1);
    forge_collections.list_string_push(words, "alpha");
    forge_collections.list_string_push(words, "beta");
    forge_collections.list_string_push(words, "gamma");
    if (forge_collections.list_string_len(words) != 3) { return 7; }
    if (forge_collections.list_string_get(words, 1) != "beta") { return 8; }
    if (forge_collections.list_string_remove(words, 0) != "alpha") { return 9; }
    if (forge_collections.list_string_get(words, 0) != "beta") { return 10; }

    val map: usize = forge_collections.hash_map_string_string_create();
    if (!forge_collections.hash_map_string_string_put(map, "a", "1")) { return 11; }
    if (!forge_collections.hash_map_string_string_put(map, "b", "2")) { return 12; }
    if (forge_collections.hash_map_string_string_put(map, "a", "3")) { return 13; }
    if (forge_collections.hash_map_string_string_len(map) != 2) { return 14; }
    if (forge_collections.hash_map_string_string_get_or(map, "a", "missing") != "3") { return 15; }
    if (forge_collections.hash_map_string_string_get_or(map, "x", "missing") != "missing") { return 16; }

    // Force table growth and rehash.
    forge_collections.hash_map_string_string_put(map, "c", "3");
    forge_collections.hash_map_string_string_put(map, "d", "4");
    forge_collections.hash_map_string_string_put(map, "e", "5");
    forge_collections.hash_map_string_string_put(map, "f", "6");
    forge_collections.hash_map_string_string_put(map, "g", "7");
    forge_collections.hash_map_string_string_put(map, "h", "8");
    forge_collections.hash_map_string_string_put(map, "i", "9");
    if (forge_collections.hash_map_string_string_len(map) != 9) { return 17; }
    if (forge_collections.hash_map_string_string_get_or(map, "h", "missing") != "8") { return 18; }

    // Deletion must leave probe chains usable, and insertion must reuse the table.
    if (!forge_collections.hash_map_string_string_remove(map, "d")) { return 19; }
    if (forge_collections.hash_map_string_string_contains(map, "d")) { return 20; }
    if (forge_collections.hash_map_string_string_get_or(map, "h", "missing") != "8") { return 21; }
    if (!forge_collections.hash_map_string_string_put(map, "j", "10")) { return 22; }

    val set: usize = forge_collections.hash_set_string_create();
    if (!forge_collections.hash_set_string_insert(set, "red")) { return 23; }
    if (forge_collections.hash_set_string_insert(set, "red")) { return 24; }
    if (!forge_collections.hash_set_string_insert(set, "blue")) { return 25; }
    if (!forge_collections.hash_set_string_contains(set, "blue")) { return 26; }
    if (!forge_collections.hash_set_string_remove(set, "red")) { return 27; }
    if (forge_collections.hash_set_string_contains(set, "red")) { return 28; }

    return 0;
}
