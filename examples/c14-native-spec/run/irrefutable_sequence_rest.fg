module examples.c14.irrefutable_sequence_rest;

fn main() -> i32 {
    val values: [u32; 4] = [10u32, 20u32, 30u32, 40u32];
    val [first, second, ..rest] = values;
    if (first != 10u32 || second != 20u32 || rest[0] != 30u32 || rest[1] != 40u32) {
        return 1;
    }

    val rows: [[u32; 3]; 2] = [[1u32, 2u32, 3u32], [4u32, 5u32, 6u32]];
    var total: u32 = 0u32;
    for (val [head, ..suffix] in rows) {
        total = total + head + suffix[0] + suffix[1];
    }
    if (total != 21u32) { return 2; }
    return 0;
}
