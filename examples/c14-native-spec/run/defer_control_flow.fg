module examples.c14.defer_control_flow;

fn fallible(ok: bool) -> Result[void, void] {
    if (ok) { return Ok(); }
    return Err();
}

fn normal_order(value: &mut i32) {
    defer { *value = (*value * 10i32) + 1i32; }
    {
        defer { *value = (*value * 10i32) + 2i32; }
    }
}

fn return_order(value: &mut i32) -> i32 {
    defer { *value = (*value * 10i32) + 1i32; }
    {
        defer { *value = (*value * 10i32) + 2i32; }
        return 7i32;
    }
}

fn loop_exits(value: &mut i32) {
    var index: i32 = 0i32;
    while (index < 3i32) {
        defer { *value = (*value * 10i32) + index; }
        index = index + 1i32;
        if (index == 1i32) { continue; }
        if (index == 2i32) { break; }
    }
}

fn nested_loop_exits(value: &mut i32) {
    var outer: i32 = 0i32;
    while (outer < 3i32) {
        defer { *value = (*value * 10i32) + 9i32; }
        outer = outer + 1i32;

        var inner: i32 = 0i32;
        while (inner < 3i32) {
            defer { *value = (*value * 10i32) + inner; }
            inner = inner + 1i32;
            if (inner == 1i32) { continue; }
            if (inner == 2i32) { break; }
        }

        if (outer == 1i32) { continue; }
        if (outer == 2i32) { break; }
    }
}

fn propagate(value: &mut i32) -> Result[void, void] {
    defer { *value = (*value * 10i32) + 1i32; }
    {
        defer { *value = (*value * 10i32) + 2i32; }
        fallible(false)?;
    }
    return Ok();
}

fn main() -> i32 {
    var normal: i32 = 0i32;
    normal_order(&mut normal);
    if (normal != 21i32) { return 1i32; }

    var early: i32 = 0i32;
    if (return_order(&mut early) != 7i32) { return 2i32; }
    if (early != 21i32) { return 3i32; }

    var loop: i32 = 0i32;
    loop_exits(&mut loop);
    if (loop != 12i32) { return 4i32; }

    var nested: i32 = 0i32;
    nested_loop_exits(&mut nested);
    if (nested != 129129i32) { return 5i32; }

    var propagated: i32 = 0i32;
    val result = propagate(&mut propagated);
    if (propagated != 21i32) { return 6i32; }
    return match (result) { Ok(_) => 7i32, Err(_) => 0i32, };
}
