module examples.c14.float_native;

struct Pair {
    a: f32;
    b: f64;
}

fn mix(a: f32, b: f32) -> f32 {
    val x: f32 = a + b;
    return -x * 2.0f32;
}

fn halve(value: f64) -> f64 {
    return value / 2.0f64;
}

fn exceptional_values() -> i32 {
    val nan: f64 = 0.0f64 / 0.0f64;
    if (nan == nan) { return 3i32; }
    if (!(nan != nan)) { return 4i32; }

    val negative_zero: f64 = -0.0f64;
    if (negative_zero != 0.0f64) { return 5i32; }
    val negative_infinity: f64 = 1.0f64 / negative_zero;
    if (negative_infinity >= 0.0f64) { return 6i32; }

    val converted: f64 = f64(7i32);
    if (converted != 7.0f64) { return 7i32; }
    return 0i32;
}

fn main() -> i32 {
    val pair: Pair = Pair{a: 1.5f32, b: 2.0f64};
    val x: f32 = mix(pair.a, 0.5f32);
    val y: f64 = halve(pair.b);
    if (x >= 0.0f32) { return 1i32; }
    if (y != 1.0f64) { return 2i32; }
    return exceptional_values();
}
