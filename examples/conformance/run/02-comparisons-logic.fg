module examples.conformance.comparisons_logic;

fn main() -> i32 {
    val a: i32 = 12;
    val b: i32 = 20;

    val ordered: bool = a < b && b >= 20;
    val different: bool = a != b;
    val exclusive: bool = (a == 12) xor (b == 12);

    if (ordered && different && exclusive) {
        return 0;
    } else {
        return 2;
    }
}
