module examples.conformance.struct_values;

struct Point {
    x: i32;
    y: i32;
}

fn length_squared(p: Point) -> i32 {
    return p.x * p.x + p.y * p.y;
}

fn main() -> i32 {
    val p: Point = Point{x: 3, y: 4};

    if (length_squared(p) == 25) {
        return 0;
    } else {
        return 7;
    }
}
