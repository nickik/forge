module examples.conformance.pattern_edge_cases;

fn decode(value: Value) -> i32 {
    return match (value) {
        [..rest] => 1,
        [head, ..tail] => 2,
        Point{x, y: 0} => x,
        Shape::Circle{radius: r} => r,
        name @ Some(inner) => inner,
        {:name name, :email email?, ..} => 3,
        None{} => 4,
        _ => 0,
    };
}
