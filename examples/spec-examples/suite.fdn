{:suite :forge/spec-examples
 :version 1
 :active-kinds [:parse :check :run :syntax-negative]
 :tests [
    {:path #path "parse/01-declarations-and-variants.fg" :kind :parse :spec "§6 declarations; §10 structs; §11 enums; §12 tagged unions; §55 representation metadata"}
    {:path #path "check/01-bindings-and-control.fg" :kind :check :spec "§7 bindings; §27 if and loops"}
    {:path #path "run/01-struct-values.fg" :kind :run :spec "§10 structs; §33 positional functions" :exit 0}
    {:path #path "run/02-local-closures.fg" :kind :run :spec "§37 non-escaping closures and capture syntax" :exit 0}
    {:path #path "run/03-reference-assignment.fg" :kind :run :spec "§18 mutable references; §27 loop assignment" :exit 0}
    {:path #path "syntax-negative/01-extern-c-reserved.fg" :kind :syntax-negative :spec "§62 C ABI reserved beyond v1" :expect :syntax/extern-deferred}
    {:path #path "syntax-negative/02-switch-reserved.fg" :kind :syntax-negative :spec "§28 switch reserved beyond v1" :expect :syntax/switch-removed}
    {:path #path "syntax-negative/03-initializer-required.fg" :kind :syntax-negative :spec "§8 required initialization" :expect :syntax/initializer-required}
    {:path #path "syntax-negative/04-empty-capture-reserved.fg" :kind :syntax-negative :spec "§37 capture-free closures omit []" :expect :syntax/empty-capture-list}
    {:path #path "syntax-negative/05-check-expression-reserved.fg" :kind :syntax-negative :spec "§24 checked arithmetic; §54 prefix-only metadata" :expect :syntax/check-metadata-removed}
  ]}
