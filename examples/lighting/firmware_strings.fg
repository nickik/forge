module examples.lighting.firmware_strings;

type Register = *volatile u32;

fn debug_putc(console: Register, value: u32) -> i32 {
    unsafe {
        *console = value;
    }
    return 0;
}

fn debug_write(console: Register, text: str) -> i32 {
    var i: usize = 0;
    while (i < text.len) {
        debug_putc(console, u32(text[i]));
        i = i + 1;
    }
    return 0;
}

fn main() -> i32 {
    unsafe {
        val raw_console_address: u32 = 0xfff03000;
        val console: Register = Register(raw_console_address);
        debug_write(console, "Forge firmware starting\n");
        debug_write(console, "SIA32 strings: OK\n");
        debug_write(console, "Lighting diagnostics: OK\n");
    }
    return 0;
}
