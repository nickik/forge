module examples.lighting.firmware_strings;

type Register = *volatile u32;

fn debug_putc(console: Register, value: u32) -> i32 {
    unsafe {
        *console = value;
    }
    return 0;
}

fn debug_write_bytes(console: Register, data: *u8, len: usize) -> i32 {
    var i: usize = 0;
    while (i < len) {
        unsafe {
            debug_putc(console, u32(*(data + i)));
        }
        i = i + 1;
    }
    return 0;
}

fn main() -> i32 {
    unsafe {
        val raw_console_address: u32 = 0xfff03000;
        val console: Register = Register(raw_console_address);
        val startup = "Forge firmware starting\n";
        debug_write_bytes(console, startup.data, startup.len);
        val strings_ok = "SIA32 strings: OK\n";
        debug_write_bytes(console, strings_ok.data, strings_ok.len);
        val diagnostics_ok = "Lighting diagnostics: OK\n";
        debug_write_bytes(console, diagnostics_ok.data, diagnostics_ok.len);
    }
    return 0;
}
