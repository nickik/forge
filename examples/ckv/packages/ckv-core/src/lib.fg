module ckv_core;

import std.fs;
import std.lock;
import std.string;
import forge_collections_bootstrap;

// CKV bootstrap storage format: one UTF-8 key/value record per line:
//
//   key<TAB>value<LF>
//
// Every operation deliberately reads and parses the complete file into a fresh
// bootstrap HashMapStringString. The bootstrap collection package exists only
// for CForge execution; production Forge collection APIs use explicit allocator
// arguments and never retain allocators in collection values.
// There is no persistent index in this first implementation.

pub fn get(database_file: str, key: str) -> str {
    val file_lock: std.lock.FileLock = lock.acquire_exclusive(database_file);
    val contents: str = fs.read_text(database_file);
    val records: usize = forge_collections_bootstrap.hash_map_string_string_create();
    val lines: usize = string.line_count(contents);
    var index: usize = 0;

    while (index < lines) {
        val line: str = string.line_at(contents, index);
        if (string.has_tab(line)) {
            val record_key: str = string.before_tab(line);
            val record_value: str = string.after_tab(line);
            forge_collections_bootstrap.hash_map_string_string_put(records, record_key, record_value);
        }
        index = index + 1;
    }

    val value: str = forge_collections_bootstrap.hash_map_string_string_get_or(records, key, "");

    lock.release(file_lock);
    return value;
}

pub fn set(database_file: str, key: str, value: str) -> void {
    val file_lock: std.lock.FileLock = lock.acquire_exclusive(database_file);
    val contents: str = fs.read_text(database_file);
    val records: usize = forge_collections_bootstrap.hash_map_string_string_create();
    val lines: usize = string.line_count(contents);
    var index: usize = 0;

    // Rebuild the whole in-memory map on every mutation as well. The map is not
    // persisted; the file remains an append-only log in this bootstrap version.
    while (index < lines) {
        val line: str = string.line_at(contents, index);
        if (string.has_tab(line)) {
            val record_key: str = string.before_tab(line);
            val record_value: str = string.after_tab(line);
            forge_collections_bootstrap.hash_map_string_string_put(records, record_key, record_value);
        }
        index = index + 1;
    }

    forge_collections_bootstrap.hash_map_string_string_put(records, key, value);
    val key_tab: str = string.concat(key, "\t");
    val key_value: str = string.concat(key_tab, value);
    val record: str = string.concat(key_value, "\n");
    fs.append_text(database_file, record);

    lock.release(file_lock);
}
